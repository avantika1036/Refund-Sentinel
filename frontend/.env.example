# Refund Sentinel Frontend Environment Configuration
# Copy this file to .env and configure for your local development

# Backend API base URL (e.g., http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# API key for authentication
# The backend Docker Compose configuration uses: replace_with_a_random_string_for_local_dev
# Set this value to match the backend APP_API_KEY environment variable
# Note: VITE_ prefixed variables are exposed to the browser bundle
VITE_API_KEY=replace_with_a_random_string_for_local_dev
