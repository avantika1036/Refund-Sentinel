# Refund Sentinel backend configuration
# Copy to backend/.env for local development.

# Local default uses SQLite. For production, use PostgreSQL, for example:
# DATABASE_URL=postgresql://user:password@localhost:5432/refund_sentinel
DATABASE_URL=sqlite:///./refund_sentinel.db

APP_ENV=development
APP_API_KEY=replace_with_a_random_string_for_local_dev

# Razorpay Test Mode (optional for the offline benchmark/demo)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_INSECURE_WEBHOOK_BYPASS=false

# Optional investigator LLM. The deterministic explanation fallback works without it.
LLM_PROVIDER=gemini
LLM_API_KEY=
# GEMINI_API_KEY is also accepted when using Gemini; LLM_API_KEY takes precedence.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=10

# Deployable model artifact generated by scripts/run_evaluation.py
ML_MODEL_PATH=backend/app/models/risk_model.json
EVALUATION_RESULTS_PATH=data/results.json
ML_CLASSIFICATION_THRESHOLD=0.5
ML_BEHAVIORAL_CONFIRMATION_THRESHOLD=0.5
