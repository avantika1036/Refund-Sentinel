# =============================================================================
# Refund Sentinel — Environment Configuration
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.
# =============================================================================


# =============================================================================
# DATABASE
# Required for all phases beyond Phase 0.
# Format: postgresql+psycopg://user:password@host:port/dbname
# The values here must match the PostgreSQL service in docker-compose.yml.
# =============================================================================
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_password@localhost:5432/refund_sentinel


# =============================================================================
# APPLICATION
# =============================================================================

# Environment: development | test | production
APP_ENV=development

# API key for authenticating requests to the backend API.
# Generate a random string for local development.
# Example (do not use this value): openssl rand -hex 32
APP_API_KEY=replace_with_a_random_string_for_local_dev


# =============================================================================
# RAZORPAY TEST MODE
# Optional during development until Phase 11 (Razorpay integration).
# Obtain from: https://dashboard.razorpay.com/app/keys (Test Mode)
# =============================================================================

# Your Razorpay Test Mode key ID (starts with rzp_test_)
RAZORPAY_KEY_ID=

# Your Razorpay Test Mode key secret
RAZORPAY_KEY_SECRET=

# Webhook secret configured in the Razorpay dashboard for signature verification.
# Required to validate that incoming webhooks originate from Razorpay.
RAZORPAY_WEBHOOK_SECRET=


# =============================================================================
# LLM (EVIDENCE SUMMARIZATION)
# Optional until Phase 7 (LLM integration).
# The system degrades gracefully when this is absent:
# the structured evidence bundle is shown directly instead of a generated summary.
# Obtain from: https://console.anthropic.com/
# =============================================================================
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6


# =============================================================================
# SIMULATOR
# Controls synthetic data generation.
# Seeds must be documented and must not change after datasets are generated.
# =============================================================================

# Seed for demo dataset generation (used by scripts/seed_demo.py)
DEMO_SEED=42

# Seed for training dataset generation (used by scripts/generate_datasets.py)
TRAIN_SEED=100

# Seed for evaluation dataset generation (used by scripts/generate_datasets.py)
EVAL_SEED=200